{
  "name": "deskplane",
  "version": "0.0.0",
  "description": "A framework-agnostic, two-dimensional virtual desktop navigator for the web.",
  "keywords": [
    "carousel",
    "gesture",
    "navigation",
    "typescript",
    "virtual-desktop"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "build:demo": "vite build demo --outDir ../demo-dist --emptyOutDir",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run build:demo",
    "clean": "node scripts/clean.mjs",
    "dev": "vite demo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
